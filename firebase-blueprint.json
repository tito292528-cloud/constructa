    "AppNotification": {
      "title": "Notification",
      "description": "System alerts, due dates, low stock, and budget warnings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleAr": { "type": "string" },
        "message": { "type": "string" },
        "messageAr": { "type": "string" },
        "type": { "type": "string", "enum": ["warning", "info", "success", "danger"] },
        "isRead": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message", "type"]
    }
