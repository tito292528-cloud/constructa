    "Employee": {
      "title": "Employee & Labor",
      "description": "Staff member, site engineer, or labor personnel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "jobTitle": { "type": "string" },
        "phone": { "type": "string" },
        "type": { "type": "string", "enum": ["monthly", "daily"] },
        "rate": { "type": "number" },
        "assignedProjectId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
