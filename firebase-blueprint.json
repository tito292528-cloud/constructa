        "date": { "type": "string" },
        "description": { "type": "string" },
        "reference": { "type": "string" },
        "balanceAfter": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["bankId", "type", "amount", "date"]
    },
    "Material": {
      "title": "Material Inventory",
      "description": "Construction raw materials and warehouse stock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
