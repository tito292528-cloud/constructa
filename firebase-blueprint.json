  "firestore": {
    "/settings/company": {
      "schema": "CompanySettings",
      "description": "Company profile and financial accounting parameters"
    },
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Partner equity details"
    },
    "/partner_transactions/{transactionId}": {
      "schema": "PartnerTransaction",
      "description": "Partner capital, withdrawal, and profit records"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Construction projects and contract financials"
    },
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Legal client project contracts"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients and owners"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers and vendors"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Bills and procurement records"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Project and overhead expenditures"
    },
    "/cashbox_transactions/{transId}": {
      "schema": "Cashbox",
      "description": "Physical cash movements"
    },
    "/bank_accounts/{bankId}": {
      "schema": "BankAccount",
      "description": "Company bank accounts"
    },
    "/bank_transactions/{transId}": {
      "schema": "BankTransaction",
      "description": "Bank account statements and transactions"
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Inventory stock catalog"
    },
    "/inventory_transactions/{transId}": {
      "schema": "InventoryTransaction",
      "description": "Material additions and project dispatches"
    },
    "/subcontractors/{subcontractorId}": {
      "schema": "Subcontractor",
      "description": "Subcontractor directory"
    },
    "/subcontractor_contracts/{contractId}": {
      "schema": "SubcontractorContract",
      "description": "Subcontract agreements on projects"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Workforce and labor personnel"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Client invoices and revenue records"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trails"
    },
    "/notifications/{notifId}": {
      "schema": "AppNotification",
      "description": "System notifications"
    }
  }
