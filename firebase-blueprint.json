{
  "entities": {
    "CompanySettings": {
      "title": "Company Settings",
      "description": "Enterprise company configuration and financial defaults",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyNameAr": { "type": "string" },
        "taxNumber": { "type": "string" },
        "commercialRegister": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "currency": { "type": "string" },
        "invoicePrefix": { "type": "string" },
        "nextInvoiceNumber": { "type": "number" },
        "fiscalYear": { "type": "string" },
        "defaultLanguage": { "type": "string" },
        "defaultTheme": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["companyName", "currency"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Company shareholder with equity and profit distribution ratios",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "ownershipPercentage": { "type": "number" },
        "profitSharePercentage": { "type": "number" },
        "lossSharePercentage": { "type": "number" },
        "capitalContribution": { "type": "number" },
        "currentBalance": { "type": "number" },
        "totalWithdrawals": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "ownershipPercentage", "profitSharePercentage"]
    },
    "PartnerTransaction": {
      "title": "Partner Transaction",
      "description": "Ledger entry for partner contributions, withdrawals, or profit distributions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partnerId": { "type": "string" },
        "partnerName": { "type": "string" },
        "type": { "type": "string", "enum": ["capital_contribution", "withdrawal", "expense_paid_on_behalf", "money_received", "profit_distribution", "other"] },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["cash", "bank"] },
        "cashboxOrBankId": { "type": "string" },
        "description": { "type": "string" },
        "reference": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["partnerId", "type", "amount", "date"]
    },
    "Project": {
      "title": "Project",
      "description": "Construction project record with financial tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "contractValue": { "type": "number" },
        "startDate": { "type": "string" },
        "expectedEndDate": { "type": "string" },
        "actualEndDate": { "type": "string" },
        "projectManager": { "type": "string" },
        "status": { "type": "string", "enum": ["Planning", "Active", "On Hold", "Completed", "Cancelled"] },
        "progress": { "type": "number" },
        "expectedCost": { "type": "number" },
        "actualCost": { "type": "number" },
        "totalInvoiced": { "type": "number" },
        "totalCollected": { "type": "number" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["code", "name", "contractValue", "status"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Client project agreement terms and retentions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "contractValue": { "type": "number" },
        "retentionPercentage": { "type": "number" },
        "retentionAmount": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["contractNumber", "clientId", "projectId", "contractValue"]
    },
    "Client": {
      "title": "Client",
      "description": "Customer entity receiving construction services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "taxNumber": { "type": "string" },
        "currentBalance": { "type": "number" },
        "totalInvoiced": { "type": "number" },
        "totalPaid": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Material or equipment vendor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "taxNumber": { "type": "string" },
        "currentBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "totalPaid": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "Purchase": {
      "title": "Purchase Invoice",
      "description": "Procurement bills for materials, tools, or equipment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string", "enum": ["Materials", "Equipment", "Tools", "Services", "Other"] },
        "items": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "paid": { "type": "number" },
        "remaining": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "supplierId", "total", "date"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Project or overhead company expenditure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "expenseType": { "type": "string", "enum": ["project", "company"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["cash", "bank"] },
        "sourceId": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["expenseType", "category", "amount", "date", "paymentMethod"]
    },
    "Cashbox": {
      "title": "Cashbox Transaction",
